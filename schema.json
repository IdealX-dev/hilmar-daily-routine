{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hilmar Tracking Data v2",
  "type": "object",
  "required": [
    "version",
    "client",
    "requests",
    "summary",
    "last_updated"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "contact": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "date_range": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "$ref": "#/definitions/summary"
    },
    "requests": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/request"
      }
    },
    "lane_summary": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/lane"
      }
    },
    "carrier_summary": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/carrier"
      }
    },
    "mdolx_bookings": {
      "type": "array"
    },
    "qc": {
      "type": "object"
    },
    "escalations_sent": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  },
  "definitions": {
    "request": {
      "type": "object",
      "required": [
        "request_id",
        "request_date",
        "lane",
        "origin",
        "destination",
        "containers",
        "teu_requested",
        "status",
        "quoted"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "Stable dedup key: hash of conversationId + request_timestamp + destination"
        },
        "request_date": {
          "type": "string",
          "format": "date"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Legacy alias for request_date"
        },
        "request_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "datetime": {
          "type": "string",
          "format": "date-time"
        },
        "conversationId": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "lane": {
          "type": "string"
        },
        "containers": {
          "type": "string"
        },
        "container_count": {
          "type": "integer",
          "minimum": 0
        },
        "teu_requested": {
          "type": "integer",
          "minimum": 0
        },
        "product": {
          "type": [
            "string",
            "null"
          ]
        },
        "temperature": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_dates": {
          "type": [
            "string",
            "null"
          ]
        },
        "eta_requested": {
          "type": [
            "string",
            "null"
          ]
        },
        "cutoff_requested": {
          "type": [
            "string",
            "null"
          ]
        },
        "free_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "lonny_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "response_timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ol_responder": {
          "type": [
            "string",
            "null"
          ]
        },
        "quoted": {
          "type": "boolean"
        },
        "carrier_quoted": {
          "type": [
            "string",
            "null"
          ]
        },
        "vessel_offered": {
          "type": [
            "string",
            "null"
          ]
        },
        "ol_rate": {
          "type": [
            "string",
            "null"
          ]
        },
        "etd_offered": {
          "type": [
            "string",
            "null"
          ]
        },
        "eta_offered": {
          "type": [
            "string",
            "null"
          ]
        },
        "transshipment": {
          "type": [
            "string",
            "null"
          ]
        },
        "erd": {
          "type": [
            "string",
            "null"
          ]
        },
        "doc_cutoff": {
          "type": [
            "string",
            "null"
          ]
        },
        "port_cutoff": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin_free_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "dest_free_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnaround_hours": {
          "type": [
            "number",
            "null"
          ]
        },
        "turnaround_biz_hours": {
          "type": [
            "number",
            "null"
          ]
        },
        "after_hours_request": {
          "type": "boolean"
        },
        "lonny_time_pt": {
          "type": [
            "string",
            "null"
          ]
        },
        "olusa_time_et": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "WIN",
            "LOSS",
            "PENDING"
          ]
        },
        "has_send": {
          "type": "boolean"
        },
        "carrier_won": {
          "type": [
            "string",
            "null"
          ]
        },
        "vessel": {
          "type": [
            "string",
            "null"
          ]
        },
        "teu_won": {
          "type": "integer",
          "minimum": 0
        },
        "mdolx_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "mdolx_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "loss_reason": {
          "enum": [
            "NO_RESPONSE",
            "PRICE",
            "ETD_MISS",
            "OTHER",
            null
          ]
        },
        "etd_fit_days": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Days between Lonny's requested date and OL offered ETD/ETA. Negative = earlier than asked."
        },
        "status_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "from": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "to": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "special_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "ol_responder_email": {
          "type": [
            "string",
            "null"
          ],
          "description": "Email address of the OL-USA responder (mailbox or individual)."
        },
        "ol_responder_signer": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human name on the From-line of the OL email when the responder is a shared mailbox. E.g. 'Caren Tobel', 'Linda Echevarria'. NEW: added 2026-04-30 for negotiation accountability."
        },
        "competitor_carrier_won": {
          "type": [
            "string",
            "null"
          ],
          "description": "Carrier that won the booking when OL lost. Often null \u2014 Lonny doesn't always tell us. Captured if visible in his reply or a follow-up booking confirmation. NEW: added 2026-04-30."
        },
        "ol_quote_count": {
          "type": [
            "integer",
            "null"
          ],
          "description": "How many distinct OL quotes were offered on this thread (count of carrier_quoted entries across replies). Helps spot multi-option threads."
        },
        "win_carrier_signer": {
          "type": [
            "string",
            "null"
          ],
          "description": "Person at OL who confirmed the booking (signed the MDOLX confirmation). May differ from ol_responder_signer."
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_entries",
        "wins",
        "quoted_lost",
        "not_quoted",
        "pending_hilmar",
        "win_rate",
        "quote_rate",
        "teu_won",
        "teu_requested"
      ],
      "properties": {
        "total_entries": {
          "type": "integer"
        },
        "wins": {
          "type": "integer"
        },
        "quoted_lost": {
          "type": "integer"
        },
        "not_quoted": {
          "type": "integer"
        },
        "pending_hilmar": {
          "type": "integer"
        },
        "win_rate": {
          "type": "number",
          "description": "Percent. wins / (wins + quoted_lost + not_quoted). Pending excluded."
        },
        "quote_rate": {
          "type": "number",
          "description": "Percent. (wins + quoted_lost + pending) / total. Pending counts as quoted."
        },
        "teu_won": {
          "type": "integer"
        },
        "teu_requested": {
          "type": "integer"
        },
        "teu_quoted_lost": {
          "type": "integer"
        },
        "teu_not_quoted": {
          "type": "integer"
        },
        "teu_pending": {
          "type": "integer"
        },
        "turnaround_entries": {
          "type": "integer"
        },
        "turnaround_avg_biz_hours": {
          "type": "number"
        },
        "turnaround_avg_clock_hours": {
          "type": "number"
        },
        "dod": {
          "type": "object"
        }
      }
    },
    "lane": {
      "type": "object",
      "required": [
        "lane",
        "requests",
        "wins",
        "quoted_lost",
        "not_quoted",
        "pending"
      ],
      "properties": {
        "lane": {
          "type": "string"
        },
        "requests": {
          "type": "integer"
        },
        "wins": {
          "type": "integer"
        },
        "quoted_lost": {
          "type": "integer"
        },
        "not_quoted": {
          "type": "integer"
        },
        "pending": {
          "type": "integer"
        },
        "teu_requested": {
          "type": "integer"
        },
        "teu_won": {
          "type": "integer"
        },
        "teu_quoted_lost": {
          "type": "integer"
        },
        "teu_not_quoted": {
          "type": "integer"
        },
        "teu_pending": {
          "type": "integer"
        },
        "winning_carriers": {
          "type": "string"
        },
        "equipment": {
          "type": "string"
        }
      }
    },
    "carrier": {
      "type": "object",
      "required": [
        "carrier",
        "quotes",
        "wins",
        "losses"
      ],
      "properties": {
        "carrier": {
          "type": "string"
        },
        "quotes": {
          "type": "integer"
        },
        "wins": {
          "type": "integer"
        },
        "losses": {
          "type": "integer",
          "description": "Quoted & Lost only (NQ separate)"
        },
        "pending": {
          "type": "integer"
        },
        "win_rate": {
          "type": "number"
        },
        "teu_won": {
          "type": "integer"
        },
        "teu_lost": {
          "type": "integer"
        },
        "lanes_quoted": {
          "type": "integer"
        },
        "avg_turnaround_biz_hours": {
          "type": [
            "number",
            "null"
          ]
        },
        "avg_etd_fit_days": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}